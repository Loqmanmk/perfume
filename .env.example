# Copy to .env and fill in. The admin account is created on first start.
# Port of the API server. Hosting platforms that set PORT are also supported.
API_PORT=8787
# Origins allowed to call the API (the Vite dev server in development).
APP_ORIGIN=http://localhost:5173
ADMIN_NAME=Store admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-long-password
# Optional overrides
# DATABASE_FILE=server/data/nuee.db
# UPLOADS_DIR=server/data/uploads
# NODE_ENV=production   # enables secure (HTTPS-only) cookies

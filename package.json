{
  "name": "nuee-parfums",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@hookform/resolvers": "^7.0.6",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.18",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
